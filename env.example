# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables (never commit real values).

# Optional: canonical site URL for metadata when not on Vercel (production domain).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only API keys
TWELVEDATA_API_KEY=
CORSFIX_API_KEY=

# Server-only IOL config
# Comma-separated listing exchanges (quotes + UDF). Unset = BCBA,NYSE,NASDAQ,AMEX,ARCA,BATS. Empty = disable IOL-first.
# IOL_LISTING_EXCHANGES=BCBA,NYSE,NASDAQ

# Set to 0 to skip IOL UDF daily charts (TwelveData-only for those exchanges).
# IOL_UDF_CHARTS=0

# Legacy alias for IOL_UDF_CHARTS=0:
# BCBA_IOL_CHARTS=0
