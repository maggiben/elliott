# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables (never commit real values).
# All NEXT_PUBLIC_* vars are embedded in the browser bundle — not server-only secrets.

# Optional: TwelveData API key (defaults to "demo"; equity quotes/charts may be rate-limited).
NEXT_PUBLIC_TWELVEDATA_API_KEY=

# Optional: Corsfix proxy for IOL listing HTML when browser CORS blocks direct fetch.
NEXT_PUBLIC_CORSFIX_API_KEY=

# Comma-separated IOL listing exchanges (quotes + UDF charts try IOL before TwelveData).
# Unset = BCBA,NYSE,NASDAQ,AMEX,ARCA,BATS. Empty = disable IOL-first for all.
# NEXT_PUBLIC_IOL_LISTING_EXCHANGES=BCBA,NYSE,NASDAQ

# Set to 0 to skip IOL UDF daily chart fetch (TwelveData-only for those exchanges).
# NEXT_PUBLIC_IOL_UDF_CHARTS=0

# Legacy alias (also honored if set to 0):
# NEXT_PUBLIC_BCBA_IOL_CHARTS=0